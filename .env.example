# ==========================================
# Turnal Platform Environment Configuration
# ==========================================

# General
NODE_ENV=development
BASE_DOMAIN=turnal.live
PUBLIC_PROTOCOL=http
DEV_MODE=true

# API Server
API_PORT=4000
API_HOST=0.0.0.0
API_URL=http://localhost:4000
JWT_SECRET=super-secret-turnal-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-turnal-refresh-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Database (PostgreSQL / SQLite)
# For local dev without docker: file:./dev.db
# For production/docker: postgresql://postgres:postgres@localhost:5432/turnal?schema=public
DATABASE_URL="file:./dev.db"

# Redis (Optional in dev, fallbacks to in-memory store)
REDIS_URL=redis://localhost:6379

# Edge / Ingress Proxy Server
EDGE_PORT=8080
EDGE_HOST=0.0.0.0
EDGE_PUBLIC_URL=http://localhost:8080
EDGE_TUNNEL_WS_PATH=/tunnel/connect
EDGE_WILDCARD_DOMAIN=.localhost

# Dashboard
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_EDGE_URL=http://localhost:8080
NEXT_PUBLIC_BASE_DOMAIN=localhost:8080

# Logging
LOG_LEVEL=debug
